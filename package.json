{
  "name": "@cjitendr/lineage-mcp",
  "version": "1.0.0",
  "description": "Data Contract Sentinel — MCP server for automated lineage tracking and silent data break prevention",
  "type": "module",
  "author": "JCHETAN26",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JCHETAN26/Lineage-MCP.git"
  },
  "bugs": {
    "url": "https://github.com/JCHETAN26/Lineage-MCP/issues"
  },
  "homepage": "https://github.com/JCHETAN26/Lineage-MCP#readme",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "bin": {
    "lineage-mcp": "dist/index.js",
    "lineage": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "cli": "node dist/cli.js",
    "start": "node dist/index.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "prepublishOnly": "npm run build",
    "release": "bash scripts/release.sh",
    "release:dry": "npm run build && npm pack --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "js-yaml": "^3.14.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/js-yaml": "^3.12.10",
    "@types/node": "^20.11.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "files": [
    "dist/",
    "samples/"
  ],
  "keywords": [
    "mcp",
    "data-lineage",
    "schema",
    "sql",
    "data-contract"
  ],
  "license": "MIT"
}
